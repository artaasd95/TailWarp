# TailWarp CUDA multi-stage image (SP-DEPLOY-01)
#
# BUILD: docker build -f docker/Dockerfile.cuda -t tailwarp:cuda --build-arg CUDA_VERSION=12.2 .
# RUN:   docker run --rm --gpus all tailwarp:cuda ./build/examples/experiment_run configs/experiment_student_t_cvar.json

ARG CUDA_VERSION=12.2

# --- Build stage ---
FROM nvidia/cuda:${CUDA_VERSION}.1-devel-ubuntu22.04 AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    git \
    libgtest-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY . /app

RUN cmake -B build \
        -DBUILD_TESTS=ON \
        -DBUILD_BENCHMARKS=ON \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_CUDA_ARCHITECTURES="75;80;86;90" \
    && cmake --build build -j"$(nproc)"

# --- Runtime stage ---
FROM nvidia/cuda:${CUDA_VERSION}.1-runtime-ubuntu22.04 AS runtime

LABEL maintainer="TailWarp Contributors"
LABEL description="TailWarp CUDA runtime (binaries + libs)"

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=builder /app/build/examples /app/build/examples
COPY --from=builder /app/build/bench_student_t /app/build/bench_student_t
COPY --from=builder /app/build/bench_gaussian /app/build/bench_gaussian
COPY --from=builder /app/build/libtailwarp.so /app/build/libtailwarp.so
COPY --from=builder /app/build/libtailwarp_kernels.so /app/build/libtailwarp_kernels.so
COPY --from=builder /app/configs /app/configs
COPY --from=builder /app/benchmarks/configs /app/benchmarks/configs

ENV LD_LIBRARY_PATH=/app/build:${LD_LIBRARY_PATH}
ENV CUDA_VISIBLE_DEVICES=0
ENV NVIDIA_VISIBLE_DEVICES=all

ENTRYPOINT ["./build/examples/experiment_run"]
CMD ["configs/experiment_student_t_cvar.json"]
